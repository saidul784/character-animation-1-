/* which fight's hits to show, or -1 */
static int l3FightGroup()
{
	double x;
	if (l3FightGroupActive >= 0) return l3FightGroupActive;
	x = l3PlayerCX();
	if (l3FightStarted[L3_GROUP_BG4] && !l3FightStarted[L3_GROUP_BG5] && x < L3_FIGHT5_X) return L3_GROUP_BG4;
	if (l3FightStarted[L3_GROUP_BG5] && !l3GirlDone && x < L3_GIRL_EVENT_X)               return L3_GROUP_BG5;
	return -1;
}

