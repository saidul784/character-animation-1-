static void l3StartDialogue(const L3Line *lines, int count)
{
	l3DlgLines = lines;
	l3DlgCount = count;
	l3DlgIndex = 0;
	l3DlgTimer = 0;
}

static bool l3DialogueActive()
{
	return l3DlgLines != NULL && l3DlgIndex < l3DlgCount;
}

/* long enough to read comfortably; ENTER moves on sooner */
static int l3LineTicks(const L3Line *line)
{
	return 100 + (int)strlen(line->text) * 3;
}

/* ==================== TYPED CODES ==================== */

static void l3TypeLetter(char c)
{
	int n = (int)strlen(l3Typed);
	if (n >= L3_TYPED_MAX)
	{
		memmove(l3Typed, l3Typed + 1, n);        /* drop the oldest letter */
		n--;
	}
	l3Typed[n]     = c;
	l3Typed[n + 1] = '\0';
}

static bool l3TypedEnds(const char *code)
{
	int n = (int)strlen(l3Typed), k = (int)strlen(code);
	return n >= k && strcmp(l3Typed + n - k, code) == 0;
}

/* how much of the code has been typed so far (for the on-screen progress) */
static int l3TypedProgress(const char *code)
{
	int n = (int)strlen(l3Typed), k = (int)strlen(code), len;
	for (len = (k < n ? k : n); len > 0; len--)
		if (strncmp(l3Typed + n - len, code, len) == 0)
			return len;
	return 0;
}

/* while a code has to be typed, letter keys belong to the code */
static bool l3TypingEvent()
{
	return l3Event == L3_EV_GIRL_TALK || l3Event == L3_EV_GIRL_WAIT || l3Event == L3_EV_PAYMENT;
}

/* iMain asks this before R restarts: R is a letter of the payment code */
bool level03BlocksRestart()
{
	return l3State == LEVEL03_PLAYING && l3TypingEvent();
}

/* ==================== EVENTS ==================== */

static void l3StopHonda()
{
	l3Speed     = 0;
	l3VoltTicks = 0;
	l3BikeVY    = 0;
	l3BikeAngle = 0;
}

/*  The Honda reaches a robber section: it stops by itself and stays
    stopped. The rider has to get off (ENTER) and clear the robbers.     */
static void l3StartFight(int group)
{
	int i;
	double stopX = (group == L3_GROUP_BG4) ? L3_FIGHT4_X : L3_FIGHT5_X;

	l3FightStarted[group] = true;
	l3FightGroupActive    = group;
	l3Event               = L3_EV_FIGHT;

	/*  The Honda always stops right here. A BG3 car still coming the
	    other way is taken off the road so it cannot hit the parked bike. */
	for (i = 0; i < L3_CAR_COUNT; i++)
		if (l3Cars[i].state != L3_CAR_DONE && l3Cars[i].x > l3BikeX)
		{
			l3Cars[i].state  = L3_CAR_DONE;
			l3Cars[i].passed = true;
		}

	l3StopHonda();
	l3BikeX = stopX - l3BikeW * 0.95;

	/* every robber of this section comes for the player */
	for (i = 0; i < L3_ROBBER_COUNT; i++)
		if (l3Robbers[i].group == group && l3Robbers[i].state == L3_ROB_SLEEP)
			l3Robbers[i].state = L3_ROB_WALK;

	for (i = 0; i < L3_TANK_COUNT; i++)
		if (l3Tanks[i].group == group)
			l3Tanks[i].awake = true;

	l3Message("ROBBERS!  THE HONDA HAS STOPPED  -  PRESS ENTER TO GET OFF AND FIGHT", 220);
}

static void l3StartGirlEvent()
{
	l3StopHonda();
	l3BikeX = L3_GIRL_EVENT_X;           /* BG6 exactly fills the screen */
	l3Event = L3_EV_GIRL_TALK;
	l3EventTimer = 0;
	l3GirlX = L3_GIRL_STAND_X;
	l3GirlY = L3_GROUND_Y;
	l3Typed[0] = '\0';
	l3MsgTicks = 0;
	l3StartDialogue(L3_DLG_GIRL, sizeof(L3_DLG_GIRL) / sizeof(L3_DLG_GIRL[0]));
}

/* the girl is on the Honda: new song, and from now on right-to-left */
static void l3GirlBoards()
{
	l3HasPassenger = true;
	l3GirlDone     = true;
	l3Event        = L3_EV_NONE;

	if (!l3Song3Started)
	{
		l3Song3Started = true;
		musicPlay(MUSIC_L3_SONG3);            /* stops Song 2 first */
	}

	/*  Turn the picture round. The camera is moved so the Honda does not
	    jump on screen; l3MirrorPan then eases it over to the right.      */
	l3Mirror    = true;
	l3MirrorPan = SCREEN_WIDTH - 2.0 * L3_SCREEN_X - l3BikeW;
	l3Cam       = l3BikeX - L3_SCREEN_X - l3MirrorPan;

	l3Message("HOLD ON TIGHT!  NEXT STOP: AUST", 150);
}

static void l3StartPayment()
{
	l3StopHonda();
	l3BikeX      = L3_PAY_EVENT_X;
	l3Event      = L3_EV_PAYMENT;
	l3Typed[0]   = '\0';
	l3PayStart   = clock();
	l3PayLeft    = L3_PAY_SECONDS;
	l3MsgTicks   = 0;
}

/*  Called by the Honda once per step while it is on the ground. Every
    event happens once, in route order.                                  */
static void l3CheckEventTriggers()
{
	double front = l3BikeX + l3BikeW * 0.95;

	if (l3Mode != L3_MODE_BIKE || l3Event != L3_EV_NONE || l3State != LEVEL03_PLAYING)
		return;

	if (!l3FightStarted[L3_GROUP_BG4])
	{
		if (front >= L3_FIGHT4_X)
			l3StartFight(L3_GROUP_BG4);
		return;
	}
	if (!l3FightStarted[L3_GROUP_BG5])
	{
		if (front >= L3_FIGHT5_X)
			l3StartFight(L3_GROUP_BG5);
		return;
	}
	if (!l3GirlDone)
	{
		if (l3BikeX >= L3_GIRL_EVENT_X)
			l3StartGirlEvent();
		return;
	}
	if (!l3BankDone)
	{
		if (l3BikeX >= L3_BANK_EVENT_X)
		{
			l3StopHonda();
			l3BikeX = L3_BANK_EVENT_X;
			l3Event = L3_EV_BANK_TALK;
			l3MsgTicks = 0;
			l3StartDialogue(L3_DLG_BANK, sizeof(L3_DLG_BANK) / sizeof(L3_DLG_BANK[0]));
		}
		return;
	}
	if (!l3PayDone)
	{
		if (l3BikeX >= L3_PAY_EVENT_X)
			l3StartPayment();
		return;
	}
	if (!l3FinalDone)
	{
		if (l3BikeX >= L3_FINAL_EVENT_X)
		{
			l3StopHonda();
			l3BikeX = L3_FINAL_EVENT_X;          /* BG13 exactly fills the screen */
			l3Event = L3_EV_FINAL_TALK;
			l3MsgTicks = 0;
			l3StartDialogue(L3_DLG_FINAL, sizeof(L3_DLG_FINAL) / sizeof(L3_DLG_FINAL[0]));
		}
	}
}

/* one step of whatever event is running */
static void l3UpdateEvents()
{
	/* ---- subtitles move on by themselves ---- */
	if (l3DialogueActive())
	{
		if (++l3DlgTimer > l3LineTicks(&l3DlgLines[l3DlgIndex]))
		{
			l3DlgIndex++;
			l3DlgTimer = 0;
		}
	}

	switch (l3Event)
	{
	case L3_EV_FIGHT:
		if (l3RobbersLeft(l3FightGroupActive) == 0)
		{
			l3FightCleared[l3FightGroupActive] = true;
			l3FightGroupActive = -1;
			l3Event = L3_EV_NONE;
			l3Message("ROBBERS CLEARED!  GO BACK TO THE HONDA AND PRESS ENTER", 240);
		}
		break;

	case L3_EV_GIRL_TALK:
		if (!l3DialogueActive())
		{
			l3DlgLines = NULL;
			l3Event = L3_EV_GIRL_WAIT;
		}
		break;

	case L3_EV_GIRL_WALK:
	{
		/* she walks up to the back of the Honda */
		double seat = l3BikeX + l3BikeW * 0.25;
		l3EventTimer++;
		l3GirlX -= L3_GIRL_WALK;
		if (l3GirlX <= seat)
		{
			l3GirlX = seat;
			l3Event = L3_EV_GIRL_BOARD;
			l3EventTimer = 0;
		}
		break;
	}

	case L3_EV_GIRL_BOARD:
		/* a step up and over onto the seat */
		l3EventTimer++;
		l3GirlY = L3_GROUND_Y + sin(l3EventTimer / 40.0 * L3_PI) * 45.0;
		l3GirlX += 0.6;
		if (l3EventTimer >= 40)
			l3GirlBoards();
		break;

	case L3_EV_BANK_TALK:
		if (!l3DialogueActive())
		{
			l3DlgLines = NULL;
			l3BankDone = true;
			l3Event = L3_EV_NONE;
			l3Message("TO ONE BANK - HURRY!", 90);
		}
		break;

	case L3_EV_PAYMENT:
		/* real time, not frame count: 20 seconds on any computer */
		l3PayLeft = L3_PAY_SECONDS - (double)(clock() - l3PayStart) / CLOCKS_PER_SEC;
		if (l3PayLeft <= 0)
		{
			l3PayLeft = 0;
			enterLevel03GameOver(L3_LOSE_PAYMENT);
		}
		break;

	case L3_EV_FINAL_TALK:
		if (!l3DialogueActive())
		{
			l3DlgLines = NULL;
			l3FinalDone = true;
			l3Event = L3_EV_NONE;
			enterLevel03Win();
		}
		break;
	}
}

/* ==================== INPUT ==================== */

/*  One typed letter. Each code only counts where it belongs:
    MACHINEGUNON any time, GETONTHEBIKE at the girl, COMPLETEYOURPAYMENT-
    QUICKLY during the 20 second payment.                                */
static void l3OnLetter(char c)
{
	l3TypeLetter(c);

	/* M is mute - but it is also a letter of two codes, so a lone M waits a
	   moment and is cancelled if more letters follow */
	if (c == 'M' && !l3TypingEvent())
		l3PendingMute = 22;
	else if (c != 'M')
		l3PendingMute = 0;

	if (l3State != LEVEL03_PLAYING) return;

	if (!l3HasGun && l3TypedEnds(L3_CODE_GUN))
	{
		l3HasGun = true;
		l3Message("MACHINE GUN ON  -  HOLD SPACE TO SHOOT (ON FOOT)", 200);
		sfxPlay(SFX_FUEL);
	}

	if ((l3Event == L3_EV_GIRL_TALK || l3Event == L3_EV_GIRL_WAIT) && l3TypedEnds(L3_CODE_GIRL))
	{
		l3DlgLines   = NULL;
		l3Event      = L3_EV_GIRL_WALK;
		l3EventTimer = 0;
		l3Typed[0]   = '\0';
	}

	if (l3Event == L3_EV_PAYMENT && l3TypedEnds(L3_CODE_PAY))
	{
		l3PayDone  = true;
		l3Event    = L3_EV_NONE;
		l3Typed[0] = '\0';
		l3Score   += 300;
		l3Message("PAYMENT COMPLETE  -  ONE BANK HAS RECEIVED THE FEE", 180);
		sfxPlay(SFX_WIN);
	}
}

/*  ENTER: off the Honda only when a fight has stopped it; back on only
    once that fight is cleared and the rider is standing next to it.     */
static void l3ToggleBike()
{
	if (l3Mode == L3_MODE_BIKE)
	{
		if (l3Event != L3_EV_FIGHT || !l3OnGround)
			return;

		l3Mode      = L3_MODE_DISMOUNT;
		l3ModeTimer = 0;
		l3StopHonda();

		/* the music changes the moment the rider leaves the bike */
		if (!l3Song2Started)
		{
			l3Song2Started = true;
			musicPlay(MUSIC_L3_SONG2);
		}
	}
	else if (l3Mode == L3_MODE_FOOT)
	{
		double seat = l3BikeX + l3BikeW * L3_RIDER_ON_BIKE_X;
		char buf[96];

		if (!l3FootOnGround) return;

		if (l3Event == L3_EV_FIGHT)
		{
			sprintf_s(buf, "DEFEAT THE ROBBERS FIRST  -  %d LEFT", l3RobbersLeft(l3FightGroupActive));
			l3Message(buf, 110);
			return;
		}

		if (fabs(l3FootX - seat) > L3_MOUNT_RANGE)
		{
			l3Message("WALK BACK TO YOUR HONDA, THEN PRESS ENTER", 100);
			return;
		}

		l3Mode      = L3_MODE_MOUNT;
		l3ModeTimer = 0;
		l3FootX     = seat;
		l3FootVX    = 0;
		l3Facing    = 1;
	}
}

/*  Edge-triggered keys, read once per fixed step before updateLevel03(). */
void level03HandleInput()
{
	int c;

	for (c = 'A'; c <= 'Z'; c++)
		if (keyJustPressed((unsigned char)c) || keyJustPressed((unsigned char)(c + 32)))
			l3OnLetter((char)c);

	if (l3PendingMute > 0)
	{
		l3PendingMute--;
		if (l3PendingMute == 0)
			musicToggleMute();
	}

	if (l3State != LEVEL03_PLAYING)
		return;

	/* P is a letter of the payment code - and the clock must not stop */
	if ((keyJustPressed('p') || keyJustPressed('P')) && !l3TypingEvent())
		l3Paused = !l3Paused;

	if (l3Paused)
		return;

	if ((keyJustPressed('v') || keyJustPressed('V')) &&
	    (l3Mode == L3_MODE_BIKE || l3Mode == L3_MODE_LOOP) && !l3HondaHeld())
	{
		l3VoltTicks = L3_VOLT_TICKS;
		l3Message("VOLT SPEED!", 50);
	}

	if (keyJustPressed('w') || keyJustPressed('W') || specialKeyJustPressed(GLUT_KEY_UP))
		l3JumpRequested = true;

	if (keyJustPressed(KEY_ENTER))
	{
		if (l3DialogueActive())
		{
			l3DlgIndex++;                      /* next subtitle */
			l3DlgTimer = 0;
		}
		else
			l3ToggleBike();
	}
}

/* ==================== THE HONDA ==================== */

static void l3EnterLoop()
{
	l3Mode       = L3_MODE_LOOP;
	l3LoopPhi    = -L3_PI / 2.0;              /* bottom of the circle */
	l3LoopDir    = 1;
	l3LoopEnergy = l3Speed * l3Speed;
	l3BikeX      = l3LoopCenterX() - l3BikeW * 0.5;
	l3BikeVY     = 0;
	l3OnGround   = true;
	l3BikeAngle  = 0;
}

static void l3LeaveLoopOnDeck()
{
	double rearX  = l3BikeX + l3BikeW * L3_WHEEL_REAR;
	double frontX = l3BikeX + l3BikeW * L3_WHEEL_FRONT;
	double g1 = l3SurfaceAt(rearX), g2 = l3SurfaceAt(frontX);

	l3Mode       = L3_MODE_BIKE;
	l3BikeY      = (g1 > g2) ? g1 : g2;
	l3PrevGround = l3BikeY;
	l3BikeVY     = 0;
	l3OnGround   = true;
	l3LastClimb  = 0;
}

/*  The loop is ridden with real energy: the Honda slows as it climbs and
    only makes it over the top if it came in at L3_LOOP_MIN_SPEED or more,
    which normal throttle cannot reach - VOLT SPEED can. Too slow and it
    loses grip, slides back down and rolls back out of the loop.         */
static void l3UpdateLoop()
{
	const double K = L3_LOOP_MIN_SPEED * L3_LOOP_MIN_SPEED / 5.0;   /* g * R */
	double s = sin(l3LoopPhi);
	double v2 = l3LoopEnergy - 2.0 * K * (1.0 + s);
	double v;

	if (l3VoltTicks > 0) l3VoltTicks--;

	if (l3LoopDir > 0 && (v2 <= 1.0 || (s > 0 && v2 < K * s)))
		l3LoopDir = -1;                       /* not enough speed */

	v = sqrt((v2 > 1.0) ? v2 : 1.0);
	l3LoopPhi += l3LoopDir * v / l3LoopPathRadius() * L3_LOOP_SPIN;

	if (l3LoopDir > 0 && l3LoopPhi >= 1.5 * L3_PI)
	{
		/*  The loop uses the VOLT charge up: the Honda comes out at normal
		    top speed, so the two oncoming cars still get two clean jumps. */
		l3LeaveLoopOnDeck();
		l3Speed     = L3_MAX_SPEED;
		l3VoltTicks = 0;
		if (!l3LoopCleared)
		{
			l3LoopCleared = true;
			l3Score += 100;
			l3Message("360 LOOP CLEARED!", 90);
		}
	}
	else if (l3LoopDir < 0 && l3LoopPhi <= -L3_PI / 2.0)
	{
		l3LeaveLoopOnDeck();
		l3Speed = -L3_REVERSE_MAX;
		l3Message("NOT ENOUGH SPEED!  PRESS V FOR VOLT SPEED BEFORE THE LOOP", 170);
	}
}

static void l3UpdateBike()
{
	double oldX, newX, rearX, frontX, gRear, gFront, ground, climb;
	bool held  = l3HondaHeld();
	bool volt  = (l3VoltTicks > 0) && !held;
	bool gas   = !held && (keyHeld('d') || keyHeld('D') || specialKeyHeld(GLUT_KEY_RIGHT));
	bool brake = !held && (keyHeld('a') || keyHeld('A') || specialKeyHeld(GLUT_KEY_LEFT));

	if (l3VoltTicks > 0) l3VoltTicks--;

	/* an event holds the Honda where it is: no throttle, no brake, no jump */
	if (held)
	{
		l3Speed = 0;
		l3VoltTicks = 0;
		l3JumpRequested = false;
	}

	/* ---- throttle / VOLT / brake + reverse ---- */
	if (brake)
		l3Speed -= L3_BRAKE;                      /* brakes, then rolls back */
	else if (volt)
		l3Speed += L3_VOLT_ACCEL;                 /* V pushes hard on its own */
	else if (gas)
	{
		if (l3Speed < L3_MAX_SPEED) l3Speed += L3_ACCEL;
	}
	else if (l3Speed > 0)
		l3Speed -= L3_COAST;
	else if (l3Speed < 0)
	{
		l3Speed += L3_COAST * 4;
		if (l3Speed > 0) l3Speed = 0;
	}

	if (volt)
	{
		if (l3Speed > L3_VOLT_MAX_SPEED) l3Speed = L3_VOLT_MAX_SPEED;
	}
	else if (l3Speed > L3_MAX_SPEED)
	{
		l3Speed -= L3_OVERSPEED_DECAY;            /* VOLT fades out smoothly */
		if (l3Speed < L3_MAX_SPEED) l3Speed = L3_MAX_SPEED;
	}
	if (l3Speed < -L3_REVERSE_MAX) l3Speed = -L3_REVERSE_MAX;

	/* ---- move, unless the surface ahead is a wall ---- */
	oldX = l3BikeX;
	newX = oldX + l3Speed;
	if (newX < 0) { newX = 0; l3Speed = 0; }
	if (newX > L3_WORLD_END) { newX = L3_WORLD_END; l3Speed = 0; }

	if (l3OnGround)
	{
		double a = l3SurfaceAt(newX + l3BikeW * L3_WHEEL_REAR);
		double b = l3SurfaceAt(newX + l3BikeW * L3_WHEEL_FRONT);
		double gNew = (a > b) ? a : b;
		if (gNew - l3PrevGround > L3_WALL_STEP)
		{
			newX = oldX;
			l3Speed = 0;
		}
	}
	l3BikeX = newX;

	/* ---- reaching the bottom of the loop, moving forward ---- */
	{
		double c0 = oldX + l3BikeW * 0.5, c1 = newX + l3BikeW * 0.5, lc = l3LoopCenterX();
		if (l3Speed > 0 && c0 < lc && c1 >= lc)
		{
			l3EnterLoop();
			return;
		}
	}

	/* ---- the two tyres and what is under them ---- */
	rearX  = l3BikeX + l3BikeW * L3_WHEEL_REAR;
	frontX = l3BikeX + l3BikeW * L3_WHEEL_FRONT;
	gRear  = l3SurfaceAt(rearX);
	gFront = l3SurfaceAt(frontX);
	ground = (gRear > gFront) ? gRear : gFront;

	climb = ground - l3PrevGround;
	l3PrevGround = ground;

	/* ---- W jumps (never on the loop ramp - the loop has to be ridden) ---- */
	if (l3JumpRequested && l3OnGround && !l3OnLoopRamp(l3BikeX + l3BikeW * 0.5))
	{
		double room = L3_CEILING_Y - l3BikeY;
		double v = L3_JUMP_VELOCITY;
		if (room > 0 && v > sqrt(2.0 * L3_GRAVITY * room)) v = sqrt(2.0 * L3_GRAVITY * room);
		l3BikeVY   = v;
		l3OnGround = false;
	}
	l3JumpRequested = false;

	if (l3OnGround)
	{
		l3BikeY  = ground;
		l3BikeVY = 0;

		if (climb > 0.4)
			l3LastClimb = climb;

		/* past the top of Ramp 2 the surface drops away: launch */
		if (climb < -1.0 && l3Speed > 1.0 && l3LastClimb > 0.4)
		{
			double gain = L3_LAUNCH_MIN_GAIN + L3_LAUNCH_SPEED_GAIN * (l3Speed / L3_MAX_SPEED);
			double v    = l3LastClimb * L3_RAMP_LAUNCH * gain;
			double room = L3_CEILING_Y - l3BikeY;
			if (room > 0 && v > sqrt(2.0 * L3_GRAVITY * room)) v = sqrt(2.0 * L3_GRAVITY * room);
			l3BikeVY    = v;
			l3OnGround  = false;
			l3LastClimb = 0;
		}
		else if (climb >= -1.0 && climb <= 0.4)
		{
			l3LastClimb *= 0.90;
		}
	}
	else
	{
		l3BikeVY -= L3_GRAVITY;
		if (keyHeld('s') || keyHeld('S') || specialKeyHeld(GLUT_KEY_DOWN))
			l3BikeVY -= L3_FAST_FALL;             /* S drops it much faster */

		l3BikeY += l3BikeVY;

		if (l3BikeY > L3_CEILING_Y)
		{
			l3BikeY = L3_CEILING_Y;
			if (l3BikeVY > 0) l3BikeVY = 0;
		}

		if (l3BikeY <= ground)
		{
			l3BikeY     = ground;
			l3BikeVY    = 0;
			l3OnGround  = true;
			l3LastClimb = 0;
		}
	}

	/* ---- lie along the slope so both tyres touch; level out in the air ---- */
	{
		double span   = l3BikeW * (L3_WHEEL_FRONT - L3_WHEEL_REAR);
		double target = 0;

		if (l3OnGround && span > 1.0)
		{
			target = atan2(gFront - gRear, span) * 180.0 / L3_PI;
			if (target >  32.0) target =  32.0;
			if (target < -32.0) target = -32.0;
		}
		l3BikeAngle += (target - l3BikeAngle) * (l3OnGround ? 0.35 : 0.08);
	}

	/* ---- Ramp 2 is behind the Honda: the BG3 cars may come ---- */
	if (!l3Ramp2Cleared && l3BikeX + l3BikeW * L3_WHEEL_REAR > l3Ramp2.x + l3Ramp2.w)
		l3Ramp2Cleared = true;

	/* ---- fights and story events start where the Honda gets to ---- */
	if (l3OnGround)
		l3CheckEventTriggers();
}

/* ==================== THE RIDER ON FOOT ==================== */

static void l3UpdateFoot()
{
	bool right = keyHeld('d') || keyHeld('D') || specialKeyHeld(GLUT_KEY_RIGHT);
	bool left  = keyHeld('a') || keyHeld('A') || specialKeyHeld(GLUT_KEY_LEFT);
	double target = 0, ground;

	/* D walks, D held runs; A stops, A held walks back */
	if (right && !left)
	{
		l3HoldD++;
		target   = (l3HoldD > L3_RUN_AFTER_TICKS) ? L3_FOOT_RUN : L3_FOOT_WALK;
		l3Facing = 1;
	}
	else
	{
		l3HoldD = 0;
		if (left)
		{
			target   = -L3_FOOT_BACK;
			l3Facing = -1;                     /* turns round while walking back */
		}
		else
			l3Facing = 1;                      /* otherwise always faces forward */
	}

	if (l3FootVX < target)
	{
		l3FootVX += L3_FOOT_ACCEL;
		if (l3FootVX > target) l3FootVX = target;
	}
	else if (l3FootVX > target)
	{
		l3FootVX -= L3_FOOT_ACCEL * 1.5;
		if (l3FootVX < target) l3FootVX = target;
	}

	l3FootX += l3FootVX;
	if (l3FootX < 40) { l3FootX = 40; l3FootVX = 0; }
	if (l3FootX > L3_GIRL_EVENT_X - 300)
	{
		l3FootX  = L3_GIRL_EVENT_X - 300;
		l3FootVX = 0;
		if (l3MsgTicks == 0) l3Message("GET BACK ON THE HONDA TO GO ON", 90);
	}

	/* W jumps, S brings him down fast */
	if (l3JumpRequested && l3FootOnGround)
	{
		l3FootVY = L3_FOOT_JUMP;
		l3FootOnGround = false;
	}
	l3JumpRequested = false;

	ground = l3SurfaceAt(l3FootX);

	if (l3FootOnGround)
	{
		if (ground < l3FootY - 2.0)
			l3FootOnGround = false;           /* walked off an edge */
		else
		{
			l3FootY  = ground;
			l3FootVY = 0;
		}
	}

	if (!l3FootOnGround)
	{
		l3FootVY -= L3_GRAVITY;
		if (keyHeld('s') || keyHeld('S') || specialKeyHeld(GLUT_KEY_DOWN))
			l3FootVY -= L3_FOOT_FAST_FALL;
		l3FootY += l3FootVY;

		if (l3FootY <= ground)
		{
			l3FootY  = ground;
			l3FootVY = 0;
			l3FootOnGround = true;
		}
	}

	l3FootAnim += fabs(l3FootVX);
}

/* getting off / on - fixed length animations, no control meanwhile */
#define L3_DISMOUNT_TICKS 42
#define L3_MOUNT_TICKS    18

static void l3UpdateModeAnimation()
{
	l3ModeTimer++;

	if (l3Mode == L3_MODE_DISMOUNT && l3ModeTimer >= L3_DISMOUNT_TICKS)
	{
		l3Mode   = L3_MODE_FOOT;
		l3FootX  = l3BikeX + l3BikeW * L3_RIDER_ON_BIKE_X;
		l3FootY  = l3BikeY;
		l3FootVX = 0;
		l3FootVY = 0;
		l3FootOnGround = true;
		l3Facing = 1;
		l3HoldD  = 0;
	}
	else if (l3Mode == L3_MODE_MOUNT && l3ModeTimer >= L3_MOUNT_TICKS)
	{
		l3Mode      = L3_MODE_BIKE;
		l3Speed     = 0;
		l3BikeVY    = 0;
		l3OnGround  = true;
		l3LastClimb = 0;
		{
			double a = l3SurfaceAt(l3BikeX + l3BikeW * L3_WHEEL_REAR);
			double b = l3SurfaceAt(l3BikeX + l3BikeW * L3_WHEEL_FRONT);
			l3BikeY = (a > b) ? a : b;
			l3PrevGround = l3BikeY;
		}
	}
}

/* ==================== CAMERA ==================== */

static void l3UpdateCamera()
{
	double target;

	if (l3Mode == L3_MODE_LOOP)
		return;                                   /* the loop is drawn in place */

	/*  Right-to-left: the Honda eases from the left of the screen over to
	    the right (so it can see the road ahead of it, on the left) while
	    the backgrounds keep following its progress without a jump.      */
	if (l3Mirror)
	{
		l3MirrorPan *= 0.95;
		if (l3MirrorPan < 0.5) l3MirrorPan = 0;
		l3Cam = l3BikeX - L3_SCREEN_X - l3MirrorPan;
		return;
	}

	if (l3Mode == L3_MODE_FOOT)
		target = l3FootX - (L3_SCREEN_X + l3BikeW * L3_RIDER_ON_BIKE_X);
	else
		target = l3BikeX - L3_SCREEN_X;

	/* snap while riding, glide only after a big jump (getting back on) */
	if (fabs(target - l3Cam) < 60.0)
		l3Cam = target;
	else
		l3Cam += (target - l3Cam) * 0.35;

	if (l3Cam < 0) l3Cam = 0;
	if (l3Cam > L3_ROUTE_END) l3Cam = L3_ROUTE_END;
}

/* ==================== CARS ==================== */

/*  Four oncoming cars, one at a time. Car 1 of BG2 appears once the loop
    is cleared, car 2 only after car 1 is behind the Honda plus a pause,
    so there are always two separate jumps with room to recover between
    them. BG3's pair works the same way after Ramp 2.                    */
static void l3UpdateCars()
{
	double bx, by, bw, bh;
	int i;

	l3PlayerBox(&bx, &by, &bw, &bh);

	for (i = 0; i < L3_CAR_COUNT; i++)
	{
		L3Car *c = &l3Cars[i];

		if (c->state == L3_CAR_WAITING)
		{
			bool ready;

			/*  The first car of a pair waits until the Honda is back on the
			    road after its ramp, so it never lands on top of a car.   */
			bool landed = (l3Mode == L3_MODE_BIKE && l3OnGround);

			if (i == 0)
				ready = l3LoopCleared && landed &&
				        l3BikeX > L3_LOOP_X + L3_LOOP_W - l3BikeW * 0.5;
			else if (i == 2)
				ready = l3Ramp2Cleared && landed &&
				        (l3Cars[1].passed || l3Cars[1].state == L3_CAR_DONE);
			else
				ready = l3Cars[i - 1].passed || l3Cars[i - 1].state == L3_CAR_DONE;

			/* never start a car once the Honda is deep into the fights */
			if (l3PlayerCX() > L3_FIGHT4_X - 1200)
			{
				c->state  = L3_CAR_DONE;
				c->passed = true;
				continue;
			}

			if (ready)
			{
				if (c->delay > 0)
					c->delay--;
				else
				{
					c->state = L3_CAR_DRIVING;
					c->x     = l3Cam + SCREEN_WIDTH + 10;   /* just off screen, ahead */
				}
			}
		}
		else if (c->state == L3_CAR_DRIVING)
		{
			double h = l3CarH(c->art);

			c->x -= L3_CAR_SPEED;

			if (l3Mode != L3_MODE_LOOP &&
			    rectsOverlap(bx, by, bw, bh,
			                 c->x + L3_CAR_W * 0.06, L3_GROUND_Y, L3_CAR_W * 0.88, h * 0.80))
			{
				enterLevel03GameOver(L3_LOSE_CAR);
				return;
			}

			if (!c->passed && c->x + L3_CAR_W < bx)
				c->passed = true;

			if (c->x + L3_CAR_W < l3Cam - 300)
			{
				c->state  = L3_CAR_DONE;
				c->passed = true;
			}
		}
	}
}

/* ==================== ROBBERS ==================== */

static void l3UpdateRobbers()
{
	double bx, by, bw, bh;
	double px   = l3PlayerCX();
	double feet = l3PlayerFeet();
	double vy   = l3PlayerVY();
	int i;

	l3PlayerBox(&bx, &by, &bw, &bh);

	for (i = 0; i < L3_ROBBER_COUNT; i++)
	{
		L3Robber *r = &l3Robbers[i];
		double dx, top;
		bool reachable;

		if (r->state == L3_ROB_DEAD) continue;

		/* robbers only come for the player once their fight has begun */
		if (r->state == L3_ROB_SLEEP)
		{
			if (l3FightStarted[r->group])
				r->state = L3_ROB_WALK;
			else
				continue;
		}

		if (r->cooldown > 0) r->cooldown--;

		dx = px - r->x;
		r->facing = (dx < 0) ? -1 : 1;
		top = L3_GROUND_Y + L3_ROBBER_H * 0.90;

		/* jumping onto a robber's head takes him down (no gun needed) */
		if (vy < -1.0 && feet <= top + 45 && feet >= top - 25 &&
		    bx < r->x + 30 && bx + bw > r->x - 30)
		{
			l3KillRobber(r);
			if (l3Mode == L3_MODE_FOOT) l3FootVY = 10.0;
			else                        l3BikeVY = 10.0;
			continue;
		}

		reachable = (feet < L3_GROUND_Y + 95);

		if (r->state == L3_ROB_ATTACK)
		{
			r->timer++;
			if (r->timer == 14 && !r->struck)             /* the swing lands */
			{
				r->struck = true;
				if (fabs(dx) < L3_ROBBER_REACH + 15 && reachable)
					l3RobberHit(r->group, r->x);
				if (l3State != LEVEL03_PLAYING) return;
			}
			if (r->timer >= 30)
			{
				r->state    = L3_ROB_WALK;
				r->cooldown = 40;
			}
		}
		else
		{
			if (fabs(dx) < L3_ROBBER_REACH && r->cooldown == 0 && reachable)
			{
				r->state  = L3_ROB_ATTACK;
				r->timer  = 0;
				r->struck = false;
			}
			else if (fabs(dx) > 60)
			{
				r->x    += r->facing * r->speed;
				r->anim += r->speed;
			}
		}

		/* riding into a robber: he gets a blow in, the Honda loses speed */
		if (l3Mode == L3_MODE_BIKE && fabs(l3Speed) > 3.0 && !r->bumped &&
		    rectsOverlap(bx, by, bw, bh, r->x - 32, L3_GROUND_Y, 64, L3_ROBBER_H * 0.9))
		{
			r->bumped = true;
			l3RobberHit(r->group, r->x);
			if (l3State != LEVEL03_PLAYING) return;
		}
	}
}

/* ==================== TANKS ==================== */

static void l3UpdateTanks()
{
	double bx, by, bw, bh, th = l3TankH();
	double px = l3PlayerCX();
	int i;

	l3PlayerBox(&bx, &by, &bw, &bh);

	for (i = 0; i < L3_TANK_COUNT; i++)
	{
		L3Tank *t = &l3Tanks[i];

		if (t->gone || !t->alive) continue;

		if (!t->awake && l3FightStarted[t->group])
			t->awake = true;

		/*  A tank rolls towards the player and then holds its ground a
		    set distance ahead - a road block to jump or shoot, never a
		    wall that runs over a parked Honda.                         */
		if (t->awake)
		{
			double dist = t->x - px;
			if (dist > t->hold || dist < -300)
				t->x -= L3_TANK_SPEED;
		}
		if (t->flash > 0) t->flash--;

		if (rectsOverlap(bx, by, bw, bh,
		                 t->x + L3_TANK_W * 0.14, L3_GROUND_Y, L3_TANK_W * 0.72, th * 0.70))
		{
			enterLevel03GameOver(L3_LOSE_TANK);
			return;
		}

		if (t->x + L3_TANK_W < l3Cam - 400)
			t->gone = true;
	}
}

/* ==================== SHOOTING ==================== */

static void l3UpdateShooting()
{
	int i;

	if (l3FireCooldown > 0) l3FireCooldown--;
	if (l3FireAnim > 0)     l3FireAnim--;

	/* the gun is used on foot - the rider has to get off to fight */
	if (!l3HasGun || !keyHeld(' ')) return;
	if (l3Mode != L3_MODE_FOOT) return;
	if (l3FireCooldown > 0) return;

	for (i = 0; i < L3_MAX_BULLETS; i++)
	{
		if (l3Bullets[i].active) continue;

		l3Bullets[i].vx = L3_BULLET_SPEED * l3Facing;
		l3Bullets[i].x  = l3FootX + l3Facing * 62.0;
		l3Bullets[i].y  = l3FootY + L3_FOOT_H * 0.60;
		l3Bullets[i].life   = L3_BULLET_LIFE;
		l3Bullets[i].active = true;
		break;
	}

	l3FireCooldown = L3_FIRE_EVERY;
	l3FireAnim     = 8;
}

static void l3UpdateBullets()
{
	double th = l3TankH();
	int i, k;

	for (i = 0; i < L3_MAX_BULLETS; i++)
	{
		L3Bullet *b = &l3Bullets[i];
		if (!b->active) continue;

		b->x += b->vx;
		if (--b->life <= 0 || b->x < l3Cam - 100 || b->x > l3Cam + SCREEN_WIDTH + 100)
		{
			b->active = false;
			continue;
		}

		for (k = 0; k < L3_ROBBER_COUNT && b->active; k++)
		{
			L3Robber *r = &l3Robbers[k];
			if (r->state == L3_ROB_DEAD) continue;
			if (b->x > r->x - 32 && b->x < r->x + 32 &&
			    b->y > L3_GROUND_Y && b->y < L3_GROUND_Y + L3_ROBBER_H * 0.95)
			{
				b->active = false;
				if (r->state == L3_ROB_SLEEP) r->state = L3_ROB_WALK;
				if (--r->hp <= 0)
					l3KillRobber(r);
			}
		}

		for (k = 0; k < L3_TANK_COUNT && b->active; k++)
		{
			L3Tank *t = &l3Tanks[k];
			if (!t->alive || t->gone) continue;
			if (b->x > t->x + L3_TANK_W * 0.05 && b->x < t->x + L3_TANK_W * 0.95 &&
			    b->y > L3_GROUND_Y && b->y < L3_GROUND_Y + th * 0.85)
			{
				b->active = false;
				t->awake  = true;
				t->flash  = 4;
				if (--t->hp <= 0)
				{
					t->alive = false;
					l3Score += 200;
					l3AddBoom(t->x + L3_TANK_W * 0.5, L3_GROUND_Y + th * 0.5);
					sfxPlay(SFX_BOMB);
				}
			}
		}
	}
}

/* ==================== PICKUPS, FUEL, FINISH ==================== */

static void l3UpdatePickups()
{
	double bx, by, bw, bh;
	int i;

	l3PlayerBox(&bx, &by, &bw, &bh);

	for (i = 0; i < l3CoinCount; i++)
	{
		double s;
		if (l3Coins[i].taken) continue;
		s = l3Coins[i].size;
		if (rectsOverlap(bx, by, bw, bh, l3Coins[i].x - s / 2, l3Coins[i].y - s / 2, s, s))
		{
			l3Coins[i].taken = true;
			l3Score += l3Coins[i].value;
			l3CoinsTaken++;
			sfxPlay(SFX_COIN);
		}
	}

	for (i = 0; i < L3_FUEL_COUNT; i++)
	{
		if (l3Fuels[i].taken) continue;
		if (rectsOverlap(bx, by, bw, bh, l3Fuels[i].x, l3Fuels[i].y, 52, 56))
		{
			l3Fuels[i].taken = true;
			l3Fuel += L3_FUEL_PICKUP;
			if (l3Fuel > L3_FUEL_MAX) l3Fuel = L3_FUEL_MAX;
			sfxPlay(SFX_FUEL);
		}
	}
}

static void l3UpdateFuel()
{
	/* only the running Honda burns fuel - walking is free */
	if ((l3Mode == L3_MODE_BIKE || l3Mode == L3_MODE_LOOP) && fabs(l3Speed) > 0.05)
		l3Fuel -= (l3VoltTicks > 0) ? L3_FUEL_VOLT_DRAIN : L3_FUEL_DRAIN;

	/* at BG6 the engine keeps running until she is on the bike */
	if (l3Event == L3_EV_GIRL_WAIT)
		l3Fuel -= L3_FUEL_IDLE_DRAIN;

	if (l3Fuel <= 0)
	{
		l3Fuel = 0;
		enterLevel03GameOver(L3_LOSE_FUEL);
	}
}

/* ==================== BG11 / BG12 TRAFFIC ==================== */

/*  Slow oncoming cars. In the world they drive towards the Honda like the
    BG2 / BG3 cars; after the turn that reads on screen as left-to-right. */
static void l3UpdateTraffic()
{
	double bx, by, bw, bh;
	int i;

	l3PlayerBox(&bx, &by, &bw, &bh);

	for (i = 0; i < L3_TRAFFIC_COUNT; i++)
	{
		L3Traffic *c = &l3Traffic[i];
		double h;

		if (c->done) continue;

		if (!c->awake)
		{
			if (c->x - l3BikeX < L3_TRAFFIC_WAKE) c->awake = true;
			else continue;
		}

		c->x -= L3_TRAFFIC_SPEED;

		h = (l3CarArtLR[c->art].w > 0) ? L3_CAR_W * l3CarArtLR[c->art].h / (double)l3CarArtLR[c->art].w : 100.0;
		if (rectsOverlap(bx, by, bw, bh, c->x + L3_CAR_W * 0.06, L3_GROUND_Y, L3_CAR_W * 0.88, h * 0.80))
		{
			enterLevel03GameOver(L3_LOSE_CAR);
			return;
		}

		if (c->x + L3_CAR_W < l3BikeX - 1600)
			c->done = true;
	}
}

/* ==================== THE LEVEL STEP ==================== */

void updateLevel03()
{
	int i;

	for (i = 0; i < L3_MAX_BOOMS; i++)
		if (l3Booms[i].active && ++l3Booms[i].t > 45)
			l3Booms[i].active = false;

	if (l3MsgTicks > 0) l3MsgTicks--;

	if (l3State != LEVEL03_PLAYING)
	{
		l3EndTimer++;
		return;
	}
	if (l3Paused)
		return;

	l3Ticks++;
	if (l3HurtTicks > 0) l3HurtTicks--;

	switch (l3Mode)
	{
	case L3_MODE_BIKE:     l3UpdateBike();          break;
	case L3_MODE_LOOP:     l3UpdateLoop();          break;
	case L3_MODE_FOOT:     l3UpdateFoot();          break;
	case L3_MODE_DISMOUNT:
	case L3_MODE_MOUNT:    l3UpdateModeAnimation(); break;
	}
	l3JumpRequested = false;

	l3UpdateCamera();

	l3UpdateShooting();
	l3UpdateBullets();

	if (l3Mode != L3_MODE_LOOP)
	{
		l3UpdateCars();
		if (l3State != LEVEL03_PLAYING) return;

		l3UpdateRobbers();
		if (l3State != LEVEL03_PLAYING) return;

		l3UpdateTanks();
		if (l3State != LEVEL03_PLAYING) return;

		l3UpdatePickups();
	}

	l3UpdateTraffic();
	if (l3State != LEVEL03_PLAYING) return;

	l3UpdateFuel();
	if (l3State != LEVEL03_PLAYING) return;

	l3UpdateEvents();
}

/* ==================== DRAWING ==================== */

int level03BackgroundIndex()
{
	int i = (int)((l3BgCam() * L3_BG_PARALLAX) / SCREEN_WIDTH + 0.001);
	if (i < 0) i = 0;
	if (i > L3_BG_COUNT - 1) i = L3_BG_COUNT - 1;
	return i;
}

/* draws a cropped sprite standing on (cx, y); flip mirrors it */
static void l3DrawImg(const L3Img *img, double cx, double y, double scale, bool flip)
{
	int w, h, x;
	if (img->tex == 0) return;

	w = (int)(img->w * scale + 0.5);
	h = (int)(img->h * scale + 0.5);
	x = (int)(cx - w / 2.0);

	iSetColor(255, 255, 255);
	if (flip)
		iShowImage(x + w, (int)y, -w, h, img->tex);
	else
		iShowImage(x, (int)y, w, h, img->tex);
}

/* draws a sprite centred on (cx, cy), turned by deg */
static void l3DrawImgTurned(unsigned int tex, double w, double h, double cx, double cy, double deg)
{
	if (tex == 0) return;
	iSetColor(255, 255, 255);
	iRotate(cx, cy, deg);
	iShowImage((int)(cx - w / 2.0), (int)(cy - h / 2.0), (int)w, (int)h, tex);
	iUnRotate();
}

static void l3DrawBackgrounds()
{
	double slide = l3BgCam() * L3_BG_PARALLAX;
	int i;

	iSetColor(255, 255, 255);
	for (i = 0; i < L3_BG_COUNT; i++)
	{
		/*  Panels are laid out left-to-right before the turn and right-to-
		    left after it, so BG7..BG13 still arrive in order - from the side
		    the Honda is riding towards. The pictures themselves are never
		    flipped.                                                       */
		double sx = l3Mirror ? slide - i * (double)SCREEN_WIDTH
		                     : i * (double)SCREEN_WIDTH - slide;
		if (sx >= SCREEN_WIDTH) break;
		if (sx + SCREEN_WIDTH <= 0) continue;
		iShowImage((int)sx, L3_BG_Y_OFFSET, SCREEN_WIDTH, SCREEN_HEIGHT, l3BgTex[i]);
	}
}

static void l3DrawRoad()
{
	double period = 130.0, dashW = 74.0, x, off;

	iSetColor(56, 56, 60);
	iFilledRectangle(0, 0, SCREEN_WIDTH, L3_GROUND_Y);
	iSetColor(44, 44, 48);
	iFilledRectangle(0, 0, SCREEN_WIDTH, L3_GROUND_Y * 0.42);

	iSetColor(96, 96, 102);
	iFilledRectangle(0, L3_GROUND_Y - 8, SCREEN_WIDTH, 8);
